# 音频素材（大文件，不进库；gen-wav.js 可重新生成测试音）
*.wav
*.mp3
*.m4a
*.flac

# 客户端安装包（Snapcast.apk 通过 /apk 路由分发，可从 GitHub release 重新下载）
*.apk

# 下载与压缩包（snapdroid-app 内的 zip 保留）
*.zip
!snapdroid-app/**/*.zip
*.tgz
ff.tgz
rel.json
sd.json
lyric.json
pts.json
stats*.txt

# 第三方源码解压（仅根目录；snapdroid-app 内 vendored 的 C++ 源码要进库）
/src/
/src29/
/sdsrc/
ffmpeg/
snapclient/

# 安卓工程构建产物（Studio 打开会生成 .idea/local.properties/build/.cxx）
snapdroid-app/.gradle/
snapdroid-app/.idea/
snapdroid-app/build/
snapdroid-app/local.properties
snapdroid-app/*.iml
snapdroid-app/Snapcast/build/
snapdroid-app/Snapcast/.cxx/
snapdroid-app/Snapcast/.externalNativeBuild/

# 截图与临时产物（snapdroid-app 内的 png 图标要进库）
*.png
!snapdroid-app/**/*.png
blobs/

# 个人工作区数据
.workbuddy/
ui.xml
